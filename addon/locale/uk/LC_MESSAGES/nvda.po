#. Translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\clipspeak\__init__.py:189
msgid "Paste item from clipboard, if appropriate."
msgstr "Вставити елемент з буфера обміну, якщо підтримується."

#. Translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\clipspeak\__init__.py:205
msgid "Undo operation."
msgstr "Скасувати операцію."

#. Translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\clipspeak\__init__.py:220
msgid "Redo operation."
msgstr "Повторити операцію."

#. Translators: A single word representing an item in a list.
#: addon\globalPlugins\clipspeak\__init__.py:476
msgid "item"
msgstr "елемент"

#. Translators: Message to speak when undoing.
#: addon\globalPlugins\clipspeak\__init__.py:481
msgid "Undo"
msgstr "Скасовано"

#. Translators: A message spoken when redoing a previously undone operation.
#: addon\globalPlugins\clipspeak\__init__.py:485
msgid "Redo"
msgstr "Повторити"

#. Translators: A message to speak when cutting text to the clipboard.
#. Translators: A message to speak when cutting files/folders to the clipboard.
#: addon\globalPlugins\clipspeak\__init__.py:498
#: addon\globalPlugins\clipspeak\__init__.py:501
#, python-format
msgid "Cut %s"
msgstr "Вирізано %s"

#. Translators: A message spoken when copying text to the clipboard.
#. Translators: A message spoken when copying files/folders to the clipboard.
#. Translators: A message spoken when copying the path of a file.
#: addon\globalPlugins\clipspeak\__init__.py:513
#: addon\globalPlugins\clipspeak\__init__.py:523
#: addon\globalPlugins\clipspeak\__init__.py:529
#: addon\globalPlugins\clipspeak\__init__.py:542
#, python-format
msgid "Copy %s"
msgstr "Скопійовано %s"

#. Translators: A message spoken when pasting text from the clipboard.
#: addon\globalPlugins\clipspeak\__init__.py:554
#: addon\globalPlugins\clipspeak\__init__.py:561
#, python-format
