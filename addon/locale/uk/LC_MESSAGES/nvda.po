msgid "Clipboard"
msgstr "Буфер обміну"

#. Translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\clipspeak\__init__.py:153
msgid "Copy selected item to clipboard, if appropriate."
msgstr "Скопіювати вибраний елемент до буфера обміну, якщо підтримується."

#. Translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\clipspeak\__init__.py:169
